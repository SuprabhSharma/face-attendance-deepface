# Application Settings
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-long-secret
DEBUG=True

# Database
DB_PATH=attendance_system.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Scheduler Configuration
SCHEDULER_ENABLED=True
TIMEZONE=UTC

# Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# Face Recognition Threshold
FACE_RECOGNITION_THRESHOLD=0.80

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# File Upload
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# Gmail SMTP — Registration OTP only
# ─────────────────────────────────────────────────────────────
# Requirements:
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Create an App Password (Google Account → Security → App passwords).
#   3. Use that 16-character App Password as SMTP_PASSWORD (NOT your normal password).
#   4. SMTP_FROM should be the same Gmail address (or an authorized alias).
#   5. Only @gmail.com recipients are accepted by this application.
#   6. Credentials stay server-side — never expose them to the browser or commit .env.
# Limitations:
#   - Gmail enforces daily sending quotas, spam filtering, and rate limits.
#   - Delivery is not guaranteed; failed sends do not create user accounts.
#   - Localhost can use Gmail SMTP when the App Password is valid.
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@gmail.com
SMTP_PASSWORD=GMAIL_APP_PASSWORD
SMTP_FROM=sender@gmail.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# OTP policy
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
